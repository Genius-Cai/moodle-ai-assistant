# Moodle AI Assistant 环境配置

# Moodle 配置
# UNSW Moodle URL
MOODLE_BASE_URL=https://moodle.telt.unsw.edu.au

# Cookie 配置 (用于模拟登录，替代 API Token)
# 将浏览器中的 MoodleSession Cookie 复制到此处
MOODLE_SESSION_COOKIE=your_moodle_session_cookie_here

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here

# 课程ID配置（可配置多个，英文逗号分隔）
COURSE_IDS=12345,67890

# 数据库配置
DB_PATH=./data/knowledge.db

# 日志配置
LOG_LEVEL=info
LOG_PATH=./logs

# 抓取配置
FETCH_DELAY=1000  # 请求之间的延迟毫秒数，避免被反爬
FETCH_TIMEOUT=30000  # 请求超时时间，毫秒
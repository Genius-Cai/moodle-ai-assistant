# Moodle AI Assistant 环境配置示例
# 复制此文件为 .env 并填写您自己的配置

# Moodle 配置
# Moodle 网站基础 URL
MOODLE_BASE_URL=https://moodle.telt.unsw.edu.au

# Cookie 配置 (用于模拟登录，替代 API Token)
# 从浏览器开发者工具中复制 Cookie 值
# 示例: MoodleSession=abc123xyz789
MOODLE_SESSION_COOKIE=

# OpenAI 配置
# 注册 OpenAI 后获取 API 密钥: https://platform.openai.com/
OPENAI_API_KEY=

# 课程ID配置（可配置多个，英文逗号分隔）
# 可以从 Moodle 课程页面 URL 中获取，如: https://moodle.site.edu/course/view.php?id=12345
COURSE_IDS=12345,67890

# 数据库配置
DB_PATH=./data/knowledge.db

# 日志配置
LOG_LEVEL=info  # 可选: error, warn, info, debug
LOG_PATH=./logs

# 抓取配置
FETCH_DELAY=1000  # 请求之间的延迟毫秒数，避免被反爬
FETCH_TIMEOUT=30000  # 请求超时时间，毫秒